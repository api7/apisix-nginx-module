diff --git src/http/ngx_http_request.c src/http/ngx_http_request.c
--- src/http/ngx_http_request.c
+++ src/http/ngx_http_request.c
@@ -2475,6 +2475,14 @@ ngx_http_post_request(ngx_http_request_t
 {
     ngx_http_posted_request_t  **p;
 
+    for (p = &r->main->posted_requests; *p; p = &(*p)->next) {
+        if ((*p)->request == r) {
+            ngx_log_debug0(NGX_LOG_DEBUG_HTTP, r->connection->log, 0,
+                           "http request already posted");
+            return NGX_OK;
+        }
+    }
+
     if (pr == NULL) {
         pr = ngx_palloc(r->pool, sizeof(ngx_http_posted_request_t));
         if (pr == NULL) {
@@ -2485,8 +2493,6 @@ ngx_http_post_request(ngx_http_request_t
     pr->request = r;
     pr->next = NULL;
 
-    for (p = &r->main->posted_requests; *p; p = &(*p)->next) { /* void */ }
-
     *p = pr;
 
     return NGX_OK;
@@ -2606,6 +2612,8 @@ ngx_http_finalize_request(ngx_http_reque
 
             r->main->count--;
 
+            r->write_event_handler = ngx_http_request_empty_handler;
+
             if (pr->postponed && pr->postponed->request == r) {
                 pr->postponed = pr->postponed->next;
             }
