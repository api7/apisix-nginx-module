diff --git src/event/ngx_event_openssl.h src/event/ngx_event_openssl.h
--- src/event/ngx_event_openssl.h
+++ src/event/ngx_event_openssl.h
@@ -296,6 +296,17 @@
     ngx_array_t *paths);
 ngx_int_t ngx_ssl_session_cache_init(ngx_shm_zone_t *shm_zone, void *data);
 
+#if (NGX_HTTP_APISIX)
+/*
+ * apisix-nginx-module takes over the session ticket keys of an SSL_CTX whose
+ * server is marked with apisix_ssl_session_ticket_takeover, see
+ * ngx_apisix_ssl_session_ticket.c in the module
+ */
+#define NGX_APISIX_SSL_SESSION_TICKET  1
+ngx_int_t ngx_apisix_ssl_session_ticket_register(ngx_conf_t *cf,
+    ngx_ssl_t *ssl, ngx_array_t *paths);
+#endif
+
 ngx_int_t ngx_ssl_set_client_hello_callback(ngx_ssl_t *ssl,
     ngx_ssl_client_hello_arg *cb);
 #ifdef SSL_CLIENT_HELLO_SUCCESS
diff --git src/event/ngx_event_openssl.c src/event/ngx_event_openssl.c
--- src/event/ngx_event_openssl.c
+++ src/event/ngx_event_openssl.c
@@ -4883,6 +4883,21 @@
     ngx_file_info_t        fi;
     ngx_pool_cleanup_t    *cln;
     ngx_ssl_ticket_key_t  *key;
+#if (NGX_APISIX_SSL_SESSION_TICKET)
+    ngx_int_t              rc;
+
+    /*
+     * a marked context gets the module's callback instead of the native
+     * keys; this must come before the return below, which a server without
+     * a shared session cache, the stream default, would otherwise take
+     */
+
+    rc = ngx_apisix_ssl_session_ticket_register(cf, ssl, paths);
+
+    if (rc != NGX_DECLINED) {
+        return rc;
+    }
+#endif
 
     if (paths == NULL
         && SSL_CTX_get_ex_data(ssl->ctx, ngx_ssl_session_cache_index) == NULL)
