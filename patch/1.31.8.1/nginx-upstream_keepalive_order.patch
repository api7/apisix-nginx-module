+        {
+            kcf->original_init_peer = uscfp[i]->peer.init;
+
+            uscfp[i]->peer.init = ngx_http_upstream_init_keepalive_peer;
+        }
 
         /* allocate cache items and add to free queue */
 
@@ -579,6 +600,31 @@ ngx_http_upstream_keepalive_init_main_conf(ngx_conf_t *cf, void *conf)
 }
 
 
+#if (NGX_HTTP_APISIX)
+
+static ngx_int_t
+ngx_http_upstream_init_keepalive(ngx_conf_t *cf,
+    ngx_http_upstream_srv_conf_t *us)
+{
+    ngx_http_upstream_keepalive_srv_conf_t  *kcf;
+
+    kcf = ngx_http_conf_upstream_srv_conf(us,
+                                          ngx_http_upstream_keepalive_module);
+
+    if (kcf->original_init_upstream(cf, us) != NGX_OK) {
+        return NGX_ERROR;
+    }
+
+    kcf->original_init_peer = us->peer.init;
+
+    us->peer.init = ngx_http_upstream_init_keepalive_peer;
+
+    return NGX_OK;
+}
+
+#endif
+
+
 static char *
 ngx_http_upstream_keepalive(ngx_conf_t *cf, ngx_command_t *cmd, void *conf)
 {
@@ -586,6 +632,9 @@ ngx_http_upstream_keepalive(ngx_conf_t *cf, ngx_command_t *cmd, void *conf)
 
     ngx_int_t    n;
     ngx_str_t   *value;
+#if (NGX_HTTP_APISIX)
+    ngx_http_upstream_srv_conf_t  *uscf;
+#endif
 
     if (kcf->max_cached != NGX_CONF_UNSET_UINT) {
         return "is duplicate";
@@ -617,5 +666,21 @@ ngx_http_upstream_keepalive(ngx_conf_t *cf, ngx_command_t *cmd, void *conf)
         }
     }
 
+#if (NGX_HTTP_APISIX)
+    if (n == 0) {
+        return NGX_CONF_OK;
+    }
+
+    /* like before nginx 1.29.7, wrap the balancers declared above */
+
+    uscf = ngx_http_conf_get_module_srv_conf(cf, ngx_http_upstream_module);
+
+    kcf->original_init_upstream = uscf->peer.init_upstream
+                                  ? uscf->peer.init_upstream
+                                  : ngx_http_upstream_init_round_robin;
+
+    uscf->peer.init_upstream = ngx_http_upstream_init_keepalive;
+#endif
+
     return NGX_CONF_OK;
 }
