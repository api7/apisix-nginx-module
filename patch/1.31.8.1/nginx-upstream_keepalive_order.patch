 static ngx_int_t ngx_http_upstream_get_keepalive_peer(ngx_peer_connection_t *pc,
@@ -554,9 +562,22 @@ ngx_http_upstream_keepalive_init_main_conf(ngx_conf_t *cf, void *conf)
             kcf->max_cached = 32;
         }
 
-        kcf->original_init_peer = uscfp[i]->peer.init;
+#if (NGX_HTTP_APISIX)
+        if (kcf->original_init_upstream) {
+            /* wrapped by the keepalive directive */
+
+        } else if (uscfp[i]->inner_init_peer) {
